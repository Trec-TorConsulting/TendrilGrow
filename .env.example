# TendrilGrow live-validation config — COPY to .env and fill in.
# .env is gitignored. NEVER commit real tokens.

# Base URL of your Home Assistant (no trailing slash).
HA_URL=http://homeassistant.local:8123

# Long-lived access token (Profile -> Security -> Long-lived access tokens).
HA_TOKEN=paste-your-long-lived-token-here

# Optional: set to 1 to skip TLS certificate verification (self-signed HTTPS).
# HA_INSECURE=0
